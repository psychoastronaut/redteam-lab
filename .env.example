OLLAMA_MODEL=qwen2.5:14b-instruct
ALLOWED_TARGET=10.64.0.0/12
EXEC_MODE=confirm

# tamanho da janela de contexto pedida ao Ollama (options.num_ctx) em
# toda chamada a /api/chat. O default do modelo (4096) e pequeno o
# bastante pra, numa sessao real, o historico acumulado (saida de
# nmap/nikto/gobuster, ja truncada a 8000 chars cada) estourar por
# volta do passo 6-7 e o llama.cpp fazer context shift no meio da
# geracao, o que derruba a chamada com 500. 8192 e o dobro do default
# e cobre o caso real -- nao suba sem considerar o custo de VRAM do KV
# cache (RTX 3060 12GB, ja com ~9,4GB ocupados por dois modelos 7B
# residentes).
OLLAMA_NUM_CTX=8192

# modo orquestrador (agent/orchestrator.py): planner grande, worker leve
PLANNER_MODEL=qwen2.5:7b-instruct
WORKER_MODEL=qwen2.5:7b-instruct
WORKER_MAX_STEPS=10
PLANNER_MAX_PHASES=8
